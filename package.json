{
  "name": "pantry-mvp",
  "version": "1.0.0",
  "description": "Smart household pantry assistant with Linked Data capabilities",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "cd frontend && npm run build",
    "start": "node backend/dist/server.js",
    "setup": "npm install && cd frontend && npm install",
    "seed": "tsx backend/src/seed.ts"
  },
  "keywords": [
    "pantry",
    "linked-data",
    "semantic-web",
    "rdf",
    "json-ld"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "date-fns": "^3.0.0",
    "express": "^4.22.1",
    "n3": "^1.17.2",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "playwright": "^1.56.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
